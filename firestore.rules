rules_version = '2';

// ============================================================
//  근시관리 트래커 Firestore 보안 규칙
//
//  ⚠️ 이 파일은 저장소에 있는 것만으로는 아무 효력이 없습니다.
//     Firebase Console > Firestore Database > 규칙(Rules) 에
//     붙여넣고 [게시]를 눌러야 실제로 적용됩니다.
//
//  현재(수정 전) 규칙의 문제:
//    match /patients/{id} { allow read: if true; }
//      → 로그인하지 않은 누구나 전체 환자 기록을 읽을 수 있음
//    match /patients/{id} { allow write: if request.auth != null; }
//      → 익명 로그인 사용자를 포함해 아무나 모든 환자를 수정·삭제 가능
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 판별 함수 ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // 익명 로그인(둘러보기 모드)은 계정이 사라지면 연결도 함께 끊긴다.
    // 자녀 연결처럼 오래 유지되어야 하는 동작은 정식 계정만 허용한다.
    function isRealAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 관리자 이메일. 앱의 ADMIN_EMAIL 값과 반드시 같아야 합니다.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'totenhaft@gmail.com';
    }

    // 사용자 문서가 없을 때 get()이 null을 반환해 규칙이 오류로 막히는 것을 방지
    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 승인된 의사만 환자 데이터를 다룰 수 있다
    function isApprovedDoctor() {
      return userExists()
        && userData().role == 'doctor'
        && userData().approved == true;
    }

    // 자기 병원 환자인지 확인 (다른 병원 환자 접근 차단)
    function isMyClinic(clinicId) {
      return userExists() && userData().clinicId == clinicId;
    }

    // 보호자 연결 확인 (정식 방식).
    // 병원이 발급한 연결코드를 입력해야만 patientLinks 문서가 만들어지고,
    // 그 문서가 있어야 해당 환자를 읽을 수 있다.
    // 문서 ID가 "<환자ID>_<보호자UID>" 이므로 남의 자녀로는 통과할 수 없다.
    function isLinkedGuardian(pid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/patientLinks/$(pid + '_' + request.auth.uid));
    }

    // ───────── 전환기 임시 허용 (연결코드 도입 전에 가입한 보호자용) ─────────
    // ⚠️ 이 함수는 보호자가 자기 자녀 목록에 아무 이름·생년월일이나 넣으면
    //    그 환자를 열 수 있게 해준다. 기존 보호자들이 모두 연결코드로
    //    다시 연결하면 아래 함수와 patients 읽기 규칙의 호출부를 삭제할 것.
    function isLegacyRegisteredChild() {
      return userExists()
        && userData().role == 'customer'
        && resource.data.clinicId == userData().clinicId
        && userData().children.hasAny([{
             'name': resource.data.name,
             'birthDate': resource.data.birthDate
           }]);
    }


    // ---------- users ----------
    match /users/{userId} {
      // 본인 문서와 관리자만 조회 가능 (다른 사용자의 이메일·소속 노출 차단)
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // 가입: 본인 문서만 생성 가능.
      // 스스로 admin 역할을 부여하거나 approved: true 로 만드는 것을 서버에서 차단한다.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['doctor', 'customer']
        && (request.resource.data.role != 'doctor'
            || request.resource.data.approved == false);

      // 수정: 관리자는 자유롭게, 본인은 역할·승인상태를 바꿀 수 없다
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.approved == resource.data.approved);

      allow delete: if isAdmin();
    }


    // ---------- clinics ----------
    match /clinics/{clinicId} {
      // 가입 화면의 병원 선택 목록에 필요하므로 공개.
      // 병원 이름만 들어 있어 환자정보는 노출되지 않는다.
      allow read: if true;

      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }


    // ---------- patients (가장 중요) ----------
    match /patients/{patientId} {
      // 읽기: 관리자 / 같은 병원의 승인된 의사 / 연결된 보호자만.
      // 로그인하지 않은 사람은 절대 읽을 수 없다.
      allow read: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(resource.data.clinicId))
        || isLinkedGuardian(patientId)
        || isLegacyRegisteredChild();   // ← 전환 끝나면 이 줄 삭제

      // 생성: 승인된 의사가 자기 병원 소속으로만
      allow create: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(request.resource.data.clinicId));

      // 수정: 자기 병원 환자만, 그리고 다른 병원으로 옮길 수 없다
      allow update: if isAdmin()
        || (isApprovedDoctor()
            && isMyClinic(resource.data.clinicId)
            && request.resource.data.clinicId == resource.data.clinicId);

      allow delete: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(resource.data.clinicId));
    }


    // ---------- approvalRequests ----------
    match /approvalRequests/{requestId} {
      allow read: if isAdmin();
      // 본인 명의의 요청만 생성 가능
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ---------- accessCodes (병원이 발급하는 보호자 연결코드) ----------
    match /accessCodes/{code} {
      // 코드 자체가 비밀번호다. 정확한 코드를 아는 사람만 그 문서 하나를 읽을 수 있고,
      // 목록 조회(list)는 막아야 코드를 쓸어담아 대입할 수 없다.
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (isApprovedDoctor()
            && isMyClinic(request.resource.data.clinicId)
            && request.resource.data.patientId is string);

      allow update, delete: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(resource.data.clinicId));
    }


    // ---------- patientLinks (보호자 ↔ 환자 연결) ----------
    match /patientLinks/{linkId} {
      // 본인 연결만 읽을 수 있다 (안에 든 코드가 새어나가지 않도록)
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();

      // 유효한 연결코드를 아는 사람만, 본인 UID로, 그 코드가 가리키는 환자에게만 연결
      allow create: if isRealAccount()
        && linkId == request.resource.data.patientId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/accessCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.patientId == request.resource.data.patientId
        && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.expiresAt > request.time;

      // 연결 해제는 본인 또는 관리자만. 수정은 누구도 할 수 없다.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }


    // ---------- 명시적으로 나머지는 모두 차단 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
