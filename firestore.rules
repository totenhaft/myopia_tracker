rules_version = '2';

// ============================================================
//  근시관리 트래커 Firestore 보안 규칙
//
//  ⚠️ 이 파일은 저장소에 있는 것만으로는 아무 효력이 없습니다.
//     Firebase Console > Firestore Database > 규칙(Rules) 에
//     붙여넣고 [게시]를 눌러야 실제로 적용됩니다.
//
//  현재(수정 전) 규칙의 문제:
//    match /patients/{id} { allow read: if true; }
//      → 로그인하지 않은 누구나 전체 환자 기록을 읽을 수 있음
//    match /patients/{id} { allow write: if request.auth != null; }
//      → 익명 로그인 사용자를 포함해 아무나 모든 환자를 수정·삭제 가능
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 판별 함수 ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // 보호자는 로그인 없이 연결코드만으로 이용한다.
    // 앱이 뒤에서 익명 계정을 만들어 주므로 기기마다 고유한 uid가 생기고,
    // 그 uid가 기기에 저장되어 다음 방문 때 코드 없이 바로 열린다.

    // 관리자 이메일. 앱의 ADMIN_EMAIL 값과 반드시 같아야 합니다.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'totenhaft@gmail.com';
    }

    // 사용자 문서가 없을 때 get()이 null을 반환해 규칙이 오류로 막히는 것을 방지
    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 승인된 의사만 환자 데이터를 다룰 수 있다
    function isApprovedDoctor() {
      return userExists()
        && userData().get('role', '') == 'doctor'
        && userData().get('approved', false) == true;
    }

    // 자기 병원 환자인지 확인 (다른 병원 환자 접근 차단)
    function isMyClinic(clinicId) {
      return userExists() && userData().get('clinicId', null) == clinicId;
    }

    // 보호자 연결 확인 (정식 방식).
    // 병원이 발급한 연결코드를 입력해야만 patientLinks 문서가 만들어지고,
    // 그 문서가 있어야 해당 환자를 읽을 수 있다.
    // 문서 ID가 "<환자ID>_<보호자UID>" 이므로 남의 자녀로는 통과할 수 없다.
    function isLinkedGuardian(pid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/patientLinks/$(pid + '_' + request.auth.uid));
    }

    // 보호자 접근 (회원가입·로그인 방식 — 현재 사용 중인 정식 경로).
    // 로그인한 보호자가, 가입 때 고른 병원 소속이고, 본인 계정에 등록한 자녀와
    // 이름·생년월일이 정확히 일치하는 환자만 볼 수 있다.
    // 참고: 보호자가 자녀 목록에 남의 아이 이름·생년월일을 적으면 열 수 있다.
    //       관리자 화면 '사용자 관리'의 '등록한 자녀' 칸으로 확인할 수 있다.
    function isRegisteredChild() {
      return userExists()
        && userData().get('role', '') == 'customer'
        && resource.data.clinicId == userData().get('clinicId', null)
        && userData().get('children', []).hasAny([{
             'name': resource.data.name,
             'birthDate': resource.data.birthDate
           }]);
    }


    // ---------- users ----------
    match /users/{userId} {
      // 본인 문서와 관리자만 조회 가능 (다른 사용자의 이메일·소속 노출 차단)
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // 가입: 본인 문서만 생성 가능.
      // 스스로 admin 역할을 부여하거나 approved: true 로 만드는 것을 서버에서 차단한다.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['doctor', 'customer']
        && (request.resource.data.role != 'doctor'
            || request.resource.data.approved == false);

      // 수정: 관리자는 자유롭게, 본인은 역할·승인상태를 바꿀 수 없다.
      // ⚠️ 보호자 문서에는 approved 항목이 없다. 규칙에서 없는 항목을 직접 읽으면
      //    오류로 거부되므로, 반드시 get(항목, 기본값)으로 비교해야 한다.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.get('role', null) == resource.data.get('role', null)
            && request.resource.data.get('approved', null) == resource.data.get('approved', null));

      allow delete: if isAdmin();
    }


    // ---------- clinics ----------
    match /clinics/{clinicId} {
      // 가입 화면의 병원 선택 목록에 필요하므로 공개.
      // 병원 이름만 들어 있어 환자정보는 노출되지 않는다.
      allow read: if true;

      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }


    // ---------- patients (가장 중요) ----------
    match /patients/{patientId} {
      // 읽기: 관리자 / 같은 병원의 승인된 의사 / 연결된 보호자만.
      // 로그인하지 않은 사람은 절대 읽을 수 없다.
      // 보호자 조회는 '병원+이름+생년월일' 검색(쿼리)으로 이뤄지므로,
      // 쿼리로 판정 가능한 isRegisteredChild()를 문서 ID가 필요한 조건보다 먼저 둔다.
      allow read: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(resource.data.clinicId))
        || isRegisteredChild()
        || isLinkedGuardian(patientId);

      // 생성: 승인된 의사가 자기 병원 소속으로만
      allow create: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(request.resource.data.clinicId));

      // 수정: 자기 병원 환자만, 그리고 다른 병원으로 옮길 수 없다
      allow update: if isAdmin()
        || (isApprovedDoctor()
            && isMyClinic(resource.data.clinicId)
            && request.resource.data.clinicId == resource.data.clinicId);

      allow delete: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(resource.data.clinicId));
    }


    // ---------- approvalRequests ----------
    match /approvalRequests/{requestId} {
      allow read: if isAdmin();
      // 본인 명의의 요청만 생성 가능
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ---------- accessCodes (병원이 발급하는 보호자 연결코드) ----------
    match /accessCodes/{code} {
      // 코드 자체가 비밀번호다. (보호자는 익명 로그인 뒤 조회하므로 isSignedIn으로 충분)
      // 정확한 코드를 아는 사람만 그 문서 하나를 읽을 수 있고,
      // 목록 조회(list)는 막아야 코드를 쓸어담아 대입할 수 없다.
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (isApprovedDoctor()
            && isMyClinic(request.resource.data.clinicId)
            && request.resource.data.patientId is string);

      allow update, delete: if isAdmin()
        || (isApprovedDoctor() && isMyClinic(resource.data.clinicId));
    }


    // ---------- patientLinks (보호자 ↔ 환자 연결) ----------
    match /patientLinks/{linkId} {
      // 본인 연결만 읽을 수 있다 (안에 든 코드가 새어나가지 않도록).
      // 의사는 자기 환자에게 누가 연결됐는지 확인할 수 있어야 한다.
      allow get: if isAdmin() || isApprovedDoctor()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      // 목록 조회: 관리자·의사, 그리고 본인 uid로 필터한 조회만 허용
      allow list: if isAdmin() || isApprovedDoctor()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      // 유효한 연결코드를 아는 사람만, 본인 UID로, 그 코드가 가리키는 환자에게만 연결
      allow create: if isSignedIn()
        && linkId == request.resource.data.patientId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/accessCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.patientId == request.resource.data.patientId
        && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.expiresAt > request.time;

      // 열람 기록만 갱신할 수 있다. 연결 대상(환자)이나 코드는 바꿀 수 없다.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastSeenAt', 'viewCount']);

      // 연결 해제: 본인, 관리자, 또는 그 환자를 담당하는 병원의 의사
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isApprovedDoctor()
            && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.clinicId == userData().get('clinicId', null));
    }


    // ---------- 명시적으로 나머지는 모두 차단 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
